<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.backlog-board.server</string>

    <!-- 秘密を plist に焼き込まない。ラッパーが起動時に pass から取得する -->
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT__/scripts/launchd-exec.zsh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- 復号失敗時にタイトな再起動ループにしない -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/backlog-board/server.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/backlog-board/server.err.log</string>
</dict>
</plist>
